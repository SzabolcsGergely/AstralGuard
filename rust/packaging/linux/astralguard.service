[Unit]
Description=AstralGuard - per-pin 12V-2x6 current guard for ASUS ROG Astral GPUs
# The NVIDIA driver must be up for NVML and its I2C adapters.
After=nvidia-persistenced.service systemd-modules-load.service
Wants=systemd-modules-load.service

[Service]
Type=simple
ExecStartPre=/sbin/modprobe i2c-dev
ExecStart=/usr/local/bin/astralguard service
# 0 is a deliberate stop (exit from the dashboard, or the guard shut the machine down);
# anything else is a crash and gets restarted, the job the Windows watchdog does.
Restart=on-failure
RestartSec=5
Environment=GUARD_WATCHDOG=1
StateDirectory=astralguard
RuntimeDirectory=astralguard
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
